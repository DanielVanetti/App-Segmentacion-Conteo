# Copiar a .env (no se sube al repositorio) y ajustar.
# Se carga con:  python -m uvicorn app.main:app --env-file .env
# y Alembic lo lee solo.

# Base de datos (docker compose up -d db). Sin esta línea los proyectos quedan en memoria.
# Use 127.0.0.1 y no "localhost": en Windows "localhost" puede ir a IPv6 (::1) y colgarse.
DATABASE_URL=postgresql+psycopg://copas:copas_local@127.0.0.1:5434/copas

# Solo para las pruebas de tests/test_repositorio_postgis.py (esa base se vacía).
DATABASE_URL_PRUEBAS=postgresql+psycopg://copas:copas_local@127.0.0.1:5434/copas_pruebas

# Carpeta de ortomosaicos de los proyectos (por defecto backend/datos)
# DIR_DATOS=D:\copas\datos

# Rango de resolución (m/px) sin advertencia (RF-04)
# GSD_MIN=0.01
# GSD_MAX=0.075
